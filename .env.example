# Copy to .env (in this folder or the project root) and fill in.
# Without a key the demo still works: regex fields + DistilBERT only,
# no store name and no LLM safety net.
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TIMEOUT=30
# MODELS_DIR=C:\path\to\Models
